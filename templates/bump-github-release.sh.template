#!/usr/bin/env bash
# GitHub Release bump script template
# Copy to scripts/bump-{{TOKEN}}.sh and fill in the configuration block below.

set -euo pipefail

# --- Configuration ---
CASK_PATH="Casks/{{TOKEN}}.rb"
REPO="{{GITHUB_REPO}}"
ASSET_PREFIX="{{ASSET_NAME}}"   # e.g. Next-AI-Draw.io
ARCH_SUFFIX="arm64"             # e.g. arm64, x86_64, or "" for universal
TAG_PREFIX="v"                  # upstream tag prefix, usually "v"
# --- End configuration ---

API_URL="https://api.github.com/repos/${REPO}/releases/latest"

curl_github() {
  local url="$1"
  local output="$2"
  local attempt http_code

  for attempt in 1 2 3; do
    http_code="$(
      curl -sS -w '%{http_code}' -o "$output" \
        ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "$url"
    )"

    if [[ "$http_code" == "200" ]]; then
      return 0
    fi

    if [[ "$http_code" == "403" || "$http_code" == "429" ]] && [[ "$attempt" -lt 3 ]]; then
      echo "GitHub API returned HTTP ${http_code}, retrying in ${attempt}s..." >&2
      sleep "$attempt"
      continue
    fi

    echo "GitHub API request failed: HTTP ${http_code} for ${url}" >&2
    if [[ -s "$output" ]]; then
      cat "$output" >&2
    fi
    return 1
  done
}

current_version="$(ruby -e "
  cask = File.read('${CASK_PATH}')
  if cask =~ /version\\s+\"([^\"]+)\"/
    print \$1
  else
    abort 'Could not read current version from ${CASK_PATH}'
  end
")"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

api_response="${tmpdir}/release.json"
curl_github "$API_URL" "$api_response"

tag="$(ruby -rjson -e '
  data = JSON.parse(File.read(ARGV[0]))
  tag = data["tag_name"]
  abort "Missing tag_name in GitHub API response" if tag.nil? || tag.empty?
  print tag
' "$api_response")"

version="${tag#${TAG_PREFIX}}"
echo "Latest tag: $tag => version: $version"

if [[ "$version" == "$current_version" ]]; then
  echo "Already at version ${version}, nothing to do."
  exit 0
fi

if [[ -n "$ARCH_SUFFIX" ]]; then
  asset_name="${ASSET_PREFIX}-${version}-${ARCH_SUFFIX}.dmg"
else
  asset_name="${ASSET_PREFIX}-${version}.dmg"
fi

download_url="https://github.com/${REPO}/releases/download/${TAG_PREFIX}${version}/${asset_name}"

echo "Downloading ${asset_name}..."
curl -fL \
  ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} \
  "$download_url" -o "$tmpdir/asset.dmg"
arm_sha="$(shasum -a 256 "$tmpdir/asset.dmg" | awk '{print $1}')"
echo "arm sha256: $arm_sha"

ruby -i -pe "
  gsub(/version\\s+\"[^\"]+\"/, 'version \"${version}\"');
  gsub(/sha256\\s+arm:\\s+\"[0-9a-f]{64}\"/, 'sha256 arm: \"${arm_sha}\"');
" "$CASK_PATH"

echo "Updated $CASK_PATH to version ${version}"
